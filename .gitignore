.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/
.venv/

# One subfolder per run: out/<experiment>/{best.pt,last.pt,progress/,samples/}
out/
*.log
*.pt
*.png
!static/*.png
data/*.json
!data/*.json.zip

# Corpora are rebuilt by `python utils.py download` / `rank` / `icons`; the
# largest are far past the 100 MB file GitHub accepts.
data/*.jsonl
data/*.jsonl.gz

# Source downloads (icon set clones and the like): many GB, all re-fetchable.
data/raw/

# CLIP image-embedding banks from the pre-consolidation experiments.
data/*.clipimg.npy
